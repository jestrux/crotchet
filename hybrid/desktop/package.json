{
  "name": "crotchet-hybrid-desktop",
  "private": true,
  "version": "0.0.1",
  "main": "dist/index.js",
  "scripts": {
    "dev:renderer": "vite --config src/renderer/vite.config.ts",
    "dev:main": "esbuild src/main/index.ts src/main/preload.ts --outdir=dist --bundle --platform=node --format=cjs --sourcemap --external:electron --watch",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5175 wait-on http://localhost:5175 && electron . | cat",
    "dev": "concurrently -k -r \"npm:dev:*\"",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "build:main": "esbuild src/main/index.ts src/main/preload.ts --outdir=dist --bundle --platform=node --format=cjs --sourcemap --external:electron",
    "build": "npm run build:renderer && npm run build:main"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "electron": "^30.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
